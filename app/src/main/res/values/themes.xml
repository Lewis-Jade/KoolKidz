<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.Child_calculator" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <item name="colorPrimary">@color/primary_blue</item>
        <item name="colorSecondary">@color/soft_green</item>
        <item name="android:statusBarColor">@color/primary_dark_blue</item>
    </style>

    <style name="Theme.Child_calculator" parent="Base.Theme.Child_calculator" />

    <style name="CalcButtonStyle">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_gravity">fill</item>
        <item name="android:layout_margin">6dp</item>
        <item name="android:fontFamily">@font/fuzzybubbles_bold</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">32sp</item>
        <item name="android:background">@drawable/btb_background</item>
        <item name="android:elevation">4dp</item>
    </style>

    <style name="KidDialogTheme" parent="Theme.Material3.DayNight.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">true</item>
    </style>
</resources>
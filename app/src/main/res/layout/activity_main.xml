<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/main_background"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/tv_playtime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="64dp"
        android:fontFamily="@font/fuzzybubbles_bold"
        android:padding="20dp"
        android:text="@string/play_time"
        android:textColor="@color/primary_dark_blue"
        android:textSize="44sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <RadioGroup
        android:id="@+id/rd_radio_group"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="32dp"
        android:layout_marginTop="48dp"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_playtime">

        <RadioButton
            android:id="@+id/easy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_easy"
            android:button="@null"
            android:elevation="4dp"
            android:fontFamily="@font/fuzzybubbles_bold"
            android:gravity="center"
            android:padding="20dp"
            android:text="@string/easy"
            android:textColor="@color/white"
            android:textSize="28sp" />

        <RadioButton
            android:id="@+id/medium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_medium"
            android:button="@null"
            android:elevation="4dp"
            android:fontFamily="@font/fuzzybubbles_bold"
            android:gravity="center"
            android:padding="20dp"
            android:text="@string/medium"
            android:textColor="@color/white"
            android:textSize="28sp" />

        <RadioButton
            android:id="@+id/hard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_hard"
            android:button="@null"
            android:elevation="4dp"
            android:fontFamily="@font/fuzzybubbles_bold"
            android:gravity="center"
            android:padding="20dp"
            android:text="@string/hard"
            android:textColor="@color/white"
            android:textSize="28sp" />

    </RadioGroup>

</androidx.constraintlayout.widget.ConstraintLayout>
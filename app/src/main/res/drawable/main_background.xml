<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base Gradient -->
    <item>
        <shape>
            <gradient
                android:angle="45"
                android:endColor="@color/bg_gradient_end"
                android:startColor="@color/bg_gradient_start"
                android:type="linear" />
        </shape>
    </item>

    <!-- Simple pattern using shapes to represent 'math' clouds -->
    <item android:top="50dp" android:left="30dp" android:width="60dp" android:height="40dp">
        <shape android:shape="oval">
            <solid android:color="#BAFFFFFF" />
        </shape>
    </item>

    <item android:top="150dp" android:right="40dp" android:width="80dp" android:height="50dp">
        <shape android:shape="oval">
            <solid android:color="#BAFFFFFF" />
        </shape>
    </item>

    <item android:bottom="100dp" android:left="60dp" android:width="70dp" android:height="45dp">
        <shape android:shape="oval">
            <solid android:color="#BAFFFFFF" />
        </shape>
    </item>

    <item android:bottom="200dp" android:right="20dp" android:width="50dp" android:height="35dp">
        <shape android:shape="oval">
            <solid android:color="#BAFFFFFF" />



        </shape>
    </item>

    <item android:drawable="@drawable/fun_3d_cartoon_teenage_boy"
        android:gravity="bottom|right"
        android:height="200dp"
        android:width="200dp"
        android:alpha="0.3" />
    <item android:drawable="@drawable/americ_ref"
        android:gravity="top|right"
        android:height="200dp"
        android:width="200dp"
        android:alpha="0.3" />
    <item android:drawable="@drawable/xipu_sebe_230608"
        android:gravity="bottom|left"
        android:height="200dp"
        android:width="200dp"
        android:alpha="0.3" />

</layer-list>